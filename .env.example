# Server
API_PORT=8080
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swipetune

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=swipetune-tracks
S3_ACCESS_KEY=localkey
S3_SECRET_KEY=localsecret
S3_REGION=ap-northeast-1

# External Music Generation API (server-side only)
MUSIC_GEN_API_BASE=https://<provider-api>
MUSIC_GEN_API_KEY=sk-xxxx

# CORS
ALLOWED_ORIGINS=http://localhost:8081

# Mobile Client
EXPO_PUBLIC_API_BASE=http://localhost:8080

